# Fiducial Quote Fetcher — ignore rules
# Data/output directories are anchored to the repo root (leading "/") so they
# cannot accidentally hide source folders with the same name (e.g. src/main/diagnostics/).
# PDFs are NOT ignored globally: the requirements baseline (00–19) is PDF.

# ---- Dependencies ----
node_modules/

# ---- Build and packaging output ----
/out/
/dist/
/release/
/dist-electron/
*.tsbuildinfo

# ---- Test and coverage output ----
/coverage/
/playwright-report/
/test-results/
/blob-report/

# ---- Environment files and secrets ----
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.p12
*.pfx
*.cer
*.crt
*.der
*.keystore
*.jks
*.mobileprovision
*.provisionprofile
/signing/
/certs/

# ---- Local application data (never commit customer data) ----
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
/user-data/
/app-data/
/evidence/
/exports/
/sessions/
/Partitions/

# ---- Raw (unsanitised) captures; only sanitised fixtures may be committed ----
**/fixtures/raw/
/captures/

# ---- Logs and diagnostics bundles ----
/logs/
*.log
/diagnostics-export/

# ---- OS and editor files ----
.DS_Store
Thumbs.db
Desktop.ini
*.swp
.idea/
