# Normalise text files; never apply line-ending conversion to binary assets.
# The requirement PDFs are uncompressed and would otherwise be detected as text
# and corrupted by CRLF conversion on Windows clones.
* text=auto

*.pdf binary
*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
