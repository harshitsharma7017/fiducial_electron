{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023"],
    "types": ["node"],
    // The package ships its types in index.d.ts but does not name them in package.json.
    "paths": {
      "better-sqlite3-multiple-ciphers": [
        "./node_modules/better-sqlite3-multiple-ciphers/index.d.ts"
      ]
    }
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "src/renderer/src/dev/demo-*.ts",
    "src/renderer/src/dev/workflow/*.ts",
    "src/demo/portal-automation/**/*.ts",
    "test/**/*.ts",
    "scripts/**/*.d.mts",
    "electron.vite.config.mts",
    "vitest.config.mts"
  ]
}
